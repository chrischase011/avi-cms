{
  "name": "avi-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "avi dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "avi build",
    "build:web": "npm --prefix web run build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix web run typecheck",
    "check": "avi check",
    "client": "avi client",
    "install:all": "npm install && npm --prefix web install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "avi build && node dist/database/migrate.js",
    "db:seed": "avi build && node dist/database/seed.js",
    "db:studio": "drizzle-kit studio",
    "setup:admin": "avi build && node dist/database/setup-admin.js",
    "test": "avi build && node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@avijs/core": "^1.1.0",
    "@avijs/multipart": "^1.1.0",
    "@avijs/security": "^1.1.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@avijs/cli": "^1.1.0",
    "@avijs/testing": "^1.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "Headless CMS built with Avi.js, Drizzle ORM and React"
}
