# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3001

# PostgreSQL connection
DATABASE_URL=postgres://postgres@127.0.0.1:5432/db_avi_monitoring
# Used only by `npm test`; its tables are wiped on every run
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/db_avi_monitoring_test

# Sessions: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Session lifetime in seconds (8 hours)
JWT_TTL=28800
# true whenever the app is served over HTTPS
COOKIE_SECURE=false

# Admin UI origins allowed to call the API with cookies (comma separated)
WEB_ORIGINS=http://localhost:3000
# Prepended to media URLs in API responses, e.g. https://cms.example.com (empty = relative)
PUBLIC_URL=
# Serve the built admin UI (web/dist) from the API server, for production
SERVE_WEB=false
# Number of reverse proxies in front of the app
TRUST_PROXY=0

UPLOAD_DIR=uploads
# Largest upload in bytes (5 MiB)
UPLOAD_MAX_SIZE=5242880

# Login attempts per client per 15 minutes
AUTH_RATE_LIMIT=10
LOG_LEVEL=info

# First administrator, created by `npm run db:seed` or `npm run setup:admin`
# when no account with this email exists. Remove them from .env afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
